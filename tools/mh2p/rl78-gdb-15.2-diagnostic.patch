+    {
+      fprintf (stderr, "Unsupported word access to F13 port register "
+               "0x%05x, PC 0x%05x\n", address, pc);
+      exit (1);
+    }
+}
+
+static int
+f13_irq_register (int address)
+{
+  if (address >= 0xfff38 && address <= 0xfff3b)
+    return 3;
+  if ((address >= 0xfffd0 && address <= 0xfffd2)
+      || (address >= 0xfffe0 && address <= 0xfffe3))
+    return 1;
+  if ((address >= 0xfffd4 && address <= 0xfffd6)
+      || (address >= 0xfffd8 && address <= 0xfffda)
+      || (address >= 0xfffdc && address <= 0xfffde)
+      || (address >= 0xfffe4 && address <= 0xfffef))
+    return 2;
+  return 0;
+}
+
+static void
+f13_irq_check_word (int address)
+{
+  if (diagnostic_f13_irq
+      && (f13_irq_register (address) || f13_irq_register (address + 1))
+      && (f13_irq_register (address) == 3
+          || f13_irq_register (address + 1) == 3
+          || (address & 1) || !f13_irq_register (address)
+          || !f13_irq_register (address + 1)))
+    {
+      fprintf (stderr, "Unsupported word access to F13 interrupt register "
+               "0x%05x, PC 0x%05x\n", address, pc);
+      exit (1);
+    }
+}
+
+static int
+f13_tau_register (int address)
+{
+  return address == 0xf0190 || address == 0xf0191
+    || (address >= 0xf01b4 && address <= 0xf01bb)
+    || address == 0xf022a || address == 0xf022b;
+}
+
+static void
+f13_trd_require_clock (void)
+{
+  if (!(memory[0xf02c0] & 0x10))
+    {
+      fprintf (stderr, "F13 Timer RD clock disabled, PC 0x%05x\n", pc);
+      exit (1);
+    }
+}
+
+static void
+f13_tau_check_word (int address)
+{
+  if (diagnostic_f13_trd && (address == 0xf0227 || address == 0xf0229))
+    {
+      fprintf (stderr, "Unsupported overlapping word access to F13 "
+               "PWMDLY0, PC 0x%05x\n", pc);
+      exit (1);
+    }
+  if (diagnostic_f13_trd && (address == 0xf0262 || address == 0xf0263))
+    {
+      fprintf (stderr, "Unsupported word access to byte-only F13 Timer RD "
+               "start-control register, PC 0x%05x\n", pc);
+      exit (1);
+    }
+  if (diagnostic_f13_tau
+      && (address == 0xf0070 || address == 0xf0071
+          || address == 0xf0073 || address == 0xf0074
+          || ((f13_tau_register (address)
+               || f13_tau_register (address + 1))
+              && ((address & 1) || !f13_tau_register (address)
+                  || !f13_tau_register (address + 1)))))
+    {
+      fprintf (stderr, "Unsupported word access to F13 TAU0 register at "
+               "0x%05x, PC 0x%05x\n", address, pc);
+      exit (1);
+    }
+}
