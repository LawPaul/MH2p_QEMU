+int
+mh2p_diagnostic_pfdl_call (int target)
+{
+  int descriptor;
+  int frequency;
+  int voltage;
+
+  if (!diagnostic_pfdl_api
+      || (target != 0xefff8 && target != 0xef004 && target != 0xef008))
+    return 0;
+  if (target == 0xef008 && diagnostic_pfdl_open && pc == 0x124e)
+    {
+      diagnostic_pfdl_open = 0;
+      fprintf (stderr, "Diagnostic PFDL API close at PC 0x%05x; "
+               "no flash writes performed.\n", pc);
+      return 1;
+    }
+  if (target != 0xefff8 || diagnostic_pfdl_open
+      || pc != 0x11d6
+      || get_reg (RL78_Reg_C) != 0 || !(memory[0xf0090] & 1)
+      || !initted[0xf0803] || memory[0xf0803] != 1
+      || !initted[0xf0804] || !initted[0xf0805])
+    {
+      fprintf (stderr, "Unsupported diagnostic PFDL API call 0x%05x, "
+               "command 0x%02x, PC 0x%05x\n",
+               target, get_reg (RL78_Reg_C), pc);
+      exit (1);
+    }
+  descriptor = 0xf0000 | memory[0xf0804] | (memory[0xf0805] << 8);
+  frequency = mem_get_qi (descriptor);
+  voltage = mem_get_qi (descriptor + 1);
+  if (frequency != 8 || voltage != 0)
+    {
+      fprintf (stderr, "Unsupported diagnostic PFDL descriptor "
+               "frequency=%d voltage=%d, PC 0x%05x\n",
+               frequency, voltage, pc);
+      exit (1);
+    }
+  diagnostic_pfdl_open = 1;
+  set_reg (RL78_Reg_C, 0);
+  fprintf (stderr, "Diagnostic PFDL API open: original descriptor "
+           "8 MHz/full-speed; oscillator precondition assumed, "
+           "not measured. No MCU ROM instructions executed.\n");
+  return 1;
+}
