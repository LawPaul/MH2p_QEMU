+    case 0xf02c0:
+      return 0xb9;
+    case 0xf02c1:
+      return 0x0d;
+    case 0xf02c4:
+      return 0x05;
+    case 0xf02c5:
+      return 0xf7;
+    case 0xf02c2:
+      return 0x01;
+    case 0xf02c3:
+      return 0x33;
+    case 0xf02c8:
+      return 0xc3;
+    case 0xfffa0:
+      return 0xf7;
+    case 0xfffa1:
+      return 0xc1;
+    case 0xfffa4:
+      return 0x50;
+    default:
+      return 0;
+    }
+}
