+static void
+reject_unmodeled_peripheral (int address, const char *operation)
+{
+  if (diagnostic_f13_trd && address == 0xf0263)
+    {
+      f13_trd_require_clock ();
+      return;
+    }
+  if (diagnostic_f13_trd && (address == 0xf0228 || address == 0xf0229))
+    {
+      fprintf (stderr, "Unsupported byte or bit access to word-only F13 "
+               "PWMDLY0, PC 0x%05x\n", pc);
+      exit (1);
+    }
+  if (diagnostic_f13_ports && f13_port_mask (address))
+    return;
+  if (diagnostic_f13_irq && f13_irq_register (address))
+    return;
+  if (diagnostic_f13_tau && (address == 0xf0071 || address == 0xf0074))
+    return;
+  if (diagnostic_f13_tau && f13_tau_register (address))
+    {
+      fprintf (stderr, "Unsupported byte %s to word-only F13 TAU0 "
+               "diagnostic register 0x%05x, PC 0x%05x\n",
+               operation, address, pc);
+      exit (1);
+    }
+  if (diagnostic_f13_clock && f13_clock_mask (address))
+    {
+      if (strcmp (operation, "read") == 0 && !initted[address])
+        {
+          fprintf (stderr, "Unknown chip/option-dependent F13 clock reset "
+                   "read at 0x%05x, PC 0x%05x\n", address, pc);
+          exit (1);
+        }
+      return;
+    }
+  if (diagnostic_f13_pior && f13_pior_mask (address))
+    return;
+  if (diagnostic_pfdl_parameter (address))
+    {
+      if (strcmp (operation, "read") == 0 && !initted[address])
+        {
+          fprintf (stderr, "Uninitialized diagnostic PFDL parameter read "
+                   "at 0x%05x, PC 0x%05x\n", address, pc);
+          exit (1);
+        }
+      return;
+    }
+  if (((address >= 0xf0000 && address < 0xf2000)
+       || address >= 0xfff00)
+      && address != RL78_SFR_SP && address != RL78_SFR_SP + 1
+      && address != RL78_SFR_PSW && address != RL78_SFR_CS
+      && address != RL78_SFR_ES && address != RL78_SFR_PMC
+      && address != 0xf0090)
+    {
+      fprintf (stderr, "Unmodeled MH2P SubCPU peripheral %s at 0x%05x, "
+               "PC 0x%05x\n", operation, address, pc);
+      exit (1);
+    }
+}
