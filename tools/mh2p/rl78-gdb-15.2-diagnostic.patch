+    case 0xf0051:
+    case 0xf0031:
+    case 0xf0034:
+    case 0xf0035:
+    case 0xf0036:
+    case 0xf0037:
+    case 0xfff01:
+    case 0xfff21:
+    case 0xfff04:
+    case 0xfff24:
+    case 0xfff05:
+    case 0xfff25:
+    case 0xfff06:
+    case 0xfff26:
+    case 0xfff07:
+    case 0xfff27:
